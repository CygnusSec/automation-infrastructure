instance-id: ${instance_id}
local-hostname: ${hostname}
%{ if manage_network ~}
network:
  version: 2
  ethernets:
    nic0:
      match:
        name: e*
%{ if use_dhcp ~}
      dhcp4: true
%{ else ~}
      dhcp4: false
      addresses:
        - ${ipv4_address}/${ipv4_prefix_length}
%{ if ipv4_gateway != "" ~}
      gateway4: ${ipv4_gateway}
%{ endif ~}
%{ if length(dns_servers) > 0 ~}
      nameservers:
        addresses:
%{ for dns in dns_servers ~}
          - ${dns}
%{ endfor ~}
%{ endif ~}
%{ endif ~}
%{ else ~}
network:
  config: disabled
%{ endif ~}
