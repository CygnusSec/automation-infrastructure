# Prerequisite role.
ANSIBLE_TARGET_OS_FAMILY=Debian
ANSIBLE_TARGET_DISTRIBUTION=Ubuntu
ANSIBLE_PREREQUISITE_DISABLE_SWAP=true
ANSIBLE_PREREQUISITE_DISABLE_UFW=false
ANSIBLE_PREREQUISITE_TIMEZONE=
ANSIBLE_PREREQUISITE_TARGET_GROUP=all_targets
ANSIBLE_PREREQUISITE_INSTALL_FROM_LOCAL_REPO=true
ANSIBLE_PREREQUISITE_REPO_SOURCE=./repo/prerequisite
ANSIBLE_PREREQUISITE_REPO_DEST=/media/installation/prerequisite

# Docker role.
ANSIBLE_DOCKER_TARGET_GROUP=linux
ANSIBLE_DOCKER_INSTALL_FROM_LOCAL_REPO=true
ANSIBLE_DOCKER_REPO_SOURCE=./repo/docker
ANSIBLE_DOCKER_REPO_DEST=/media/installation/docker

# Installation directory cleanup.
ANSIBLE_INSTALLATION_CLEANUP_TARGET_GROUP=all_targets
ANSIBLE_INSTALLATION_CLEANUP_DIR=/media/installation

# Common iptables role.
ANSIBLE_IPTABLES_ENABLED=false
ANSIBLE_IPTABLES_TARGET_GROUP=iptables_targets
ANSIBLE_IPTABLES_RESET_ENABLED=true
ANSIBLE_IPTABLES_RESET_CHAINS="[INPUT, OUTPUT]"
ANSIBLE_IPTABLES_MANAGE_IPSETS=true
ANSIBLE_IPTABLES_IPSET_PERSIST=true
ANSIBLE_IPTABLES_IPSET_SAVE_PATH=/etc/iptables/ipsets
ANSIBLE_IPTABLES_PERSIST=true
ANSIBLE_IPTABLES_SAVE_PATH=/etc/iptables/rules.v4
ANSIBLE_IPTABLES_IPSET_PREFIX=common
ANSIBLE_IPTABLES_IPSET_SSH_SOURCES_NAME=common_ssh_sources
ANSIBLE_IPTABLES_IPSET_SSH_TARGETS_NAME=common_ssh_targets
ANSIBLE_IPTABLES_IPSET_SERVICE_SOURCES_NAME=common_service_sources
ANSIBLE_IPTABLES_IPSET_DNS_TIME_SERVERS_NAME=common_dns_time_servers
ANSIBLE_IPTABLES_IPSET_DNS_TIME_CLIENTS_NAME=common_dns_time_clients
ANSIBLE_IPTABLES_IPSET_ZABBIX_SERVERS_NAME=common_zabbix_servers
ANSIBLE_IPTABLES_IPSET_ZABBIX_AGENTS_NAME=common_zabbix_agents
ANSIBLE_IPTABLES_SSH_WHITELIST_IPS=
ANSIBLE_IPTABLES_SSH_PORT=22
# Keep this empty in INPUT/OUTPUT DROP mode. Use explicit
# INBOUND/EXTERNAL/IP_PORT rules below so every allow has ports.
ANSIBLE_IPTABLES_SERVICE_ALLOWED_SOURCE_IPS="[]"
ANSIBLE_IPTABLES_EXTERNAL_SERVICE_RULES="[{name: postgres_out, ips: [172.16.4.15, 172.16.4.16], source_ips: [172.16.3.28, 172.16.3.38], ports: [5432]}]"
ANSIBLE_IPTABLES_INBOUND_SERVICE_RULES="[]"
ANSIBLE_IPTABLES_IP_PORT_RULES="[]"
ANSIBLE_IPTABLES_ZABBIX_SERVER_IPS="[]"
ANSIBLE_IPTABLES_ZABBIX_AGENT_PORT=10050
ANSIBLE_IPTABLES_ZABBIX_SERVER_PORT=10051
ANSIBLE_IPTABLES_DNS_TIME_SERVER_IPS="[]"
ANSIBLE_IPTABLES_DNS_TIME_CLIENT_SOURCES="[]"
ANSIBLE_IPTABLES_DNS_PORT=53
ANSIBLE_IPTABLES_TIME_PORT=123
ANSIBLE_IPTABLES_ACCEPT_CHAINS="[INPUT, OUTPUT]"
ANSIBLE_IPTABLES_BLOCK_ENABLED=false
ANSIBLE_IPTABLES_BLOCK_CHAINS="[INPUT, OUTPUT]"

# Native MariaDB package cleanup.
ANSIBLE_MARIADB_REMOVE_TARGET_GROUP=all_targets
ANSIBLE_MARIADB_REMOVE_PACKAGES="[mariadb-server]"
ANSIBLE_MARIADB_REMOVE_SERVICES="[mariadb, mysql]"
ANSIBLE_MARIADB_REMOVE_PURGE=true
ANSIBLE_MARIADB_REMOVE_AUTOREMOVE=true

# Native OpenResty package cleanup.
ANSIBLE_OPENRESTY_REMOVE_TARGET_GROUP=openresty_remove_targets
ANSIBLE_OPENRESTY_REMOVE_PACKAGES="[openresty]"
ANSIBLE_OPENRESTY_REMOVE_SERVICES="[openresty]"
ANSIBLE_OPENRESTY_REMOVE_PURGE=false
ANSIBLE_OPENRESTY_REMOVE_AUTOREMOVE=true

# Native Apache2 package cleanup.
ANSIBLE_APACHE2_REMOVE_TARGET_GROUP=all_targets
ANSIBLE_APACHE2_REMOVE_PACKAGES="[apache2, apache2-bin, apache2-data, apache2-utils]"
ANSIBLE_APACHE2_REMOVE_SERVICES="[apache2]"
ANSIBLE_APACHE2_REMOVE_PURGE=false
ANSIBLE_APACHE2_REMOVE_AUTOREMOVE=true
