---
# Static inventory example only.
# The active inventory is inventories/customer-a/inventory.py, configured in
# ansible.cfg. Manage real host lists in env.d/*.env with ANSIBLE_SWARM_*,
# ANSIBLE_SSH_COPY_ID_EXTRA_HOSTS, ANSIBLE_ZABBIX_SERVER_HOSTS, and
# ANSIBLE_ZABBIX_AGENT_HOSTS.
all:
  children:
    swarm_managers:
      hosts:
        swarm-manager-01:
          ansible_host: <manager-ip>
          docker_swarm_advertise_addr: <manager-ip>

    swarm_backend_workers:
      hosts:
        backend-01:
          ansible_host: <backend-ip>
          docker_swarm_advertise_addr: <backend-ip>
          docker_swarm_node_labels:
            node_tag: backend

    swarm_workers:
      children:
        swarm_backend_workers:

    linux:
      children:
        swarm_managers:
        swarm_workers:
