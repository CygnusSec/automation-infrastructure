# Common Ansible runtime and SSH settings.
# Task-specific settings live in env.d/*.env.example.
#
# Load order:
# 1. .env
# 2. env.d/10-inventory.env
# 3. the env.d file mapped to the requested --tags value
#
# Example:
#   ./scripts/run-ansible.sh deploy --tags zabbix
# loads:
#   .env
#   env.d/10-inventory.env
#   env.d/30-zabbix-agent.env

# Ansible runtime image.
# Set RUNTIME_IMAGE to pull an image from a registry.
# Leave RUNTIME_IMAGE empty to build/use LOCAL_RUNTIME_IMAGE from build/dockerfile.
RUNTIME_IMAGE=
LOCAL_RUNTIME_IMAGE=ansible-base-runtime:local

# Runtime wrapper.
ANSIBLE_CONTROL_OFFLINE=

# Relative path under Ansible/ to the optional extra vars file with secrets.
ANSIBLE_INVENTORY_SECRET_VARS=inventories/customer-a/secrets/auth.yaml

# SSH connection.
ANSIBLE_SSH_USER=
ANSIBLE_SSH_PRIVATE_KEY_FILE=./inventories/customer-a/secrets/id_rsa
ANSIBLE_PASSWORD=
ANSIBLE_BECOME=
ANSIBLE_BECOME_METHOD=sudo
ANSIBLE_BECOME_PASSWORD=

# SSH auth mode is selected automatically:
# - ssh-copy-id uses password auth to bootstrap the public key
# - deploy uses the private key when it exists
# - deploy fails when the private key is missing; password auth is not allowed
#   for normal tasks
ANSIBLE_SSH_PASSWORD_AUTH=
ANSIBLE_SSH_PASSWORD_AUTH_OVERRIDE=
ANSIBLE_SSH_COMMON_ARGS=

# SSH key bootstrap.
# Defaults to ANSIBLE_SSH_PRIVATE_KEY_FILE + ".pub" when empty.
ANSIBLE_SSH_COPY_ID_PUBLIC_KEY_FILE=
ANSIBLE_SSH_COPY_ID_TARGET_GROUP=
