# Ansible runtime image.
# Set RUNTIME_IMAGE to pull an image from a registry.
# Leave RUNTIME_IMAGE empty to build/use LOCAL_RUNTIME_IMAGE from build/dockerfile.
RUNTIME_IMAGE=
LOCAL_RUNTIME_IMAGE=ansible-base-runtime:local

# Runtime wrapper.
# Relative path under Ansible/ to the optional extra vars file with secrets.
ANSIBLE_CONTROL_OFFLINE=
ANSIBLE_INVENTORY_SECRET_VARS=inventories/customer-a/secrets/auth.yaml

# SSH connection.
ANSIBLE_SSH_USER=
ANSIBLE_SSH_PRIVATE_KEY_FILE=./inventories/customer-a/secrets/id_rsa
ANSIBLE_PASSWORD=
ANSIBLE_BECOME=
ANSIBLE_BECOME_METHOD=sudo
ANSIBLE_BECOME_PASSWORD=
# Set true only for the first password-based SSH bootstrap run.
ANSIBLE_SSH_PASSWORD_AUTH=
ANSIBLE_SSH_COMMON_ARGS=

# SSH key bootstrap.
# Defaults to ANSIBLE_SSH_PRIVATE_KEY_FILE + ".pub" when empty.
ANSIBLE_SSH_COPY_ID_PUBLIC_KEY_FILE=
ANSIBLE_SSH_COPY_ID_TARGET_GROUP=

# Inventory hosts.
# Dynamic inventory can read hosts from these list variables.
ANSIBLE_ALL_TARGET_HOSTS=
ANSIBLE_SWARM_MANAGER_HOSTS=
# Backend and file-server groups use fixed node_tag values:
# backend -> node_tag=backend
# file-server -> node_tag=file-server
ANSIBLE_SWARM_BACKEND_WORKER_HOSTS=
ANSIBLE_SWARM_FILE_SERVER_WORKER_HOSTS=
# Cache tags map positionally to cache hosts.
# Example: 172.16.3.27 -> cache-server-ext-01.
ANSIBLE_SWARM_CACHE_SERVER_EXT_HOSTS=
ANSIBLE_SWARM_CACHE_SERVER_EXT_TAGS=
# Example: 172.16.4.17 -> cache-server-int-01.
ANSIBLE_SWARM_CACHE_SERVER_INT_HOSTS=
ANSIBLE_SWARM_CACHE_SERVER_INT_TAGS=
ANSIBLE_SSH_COPY_ID_EXTRA_HOSTS=

# Backward-compatible single-manager variables used only when
# ANSIBLE_SWARM_MANAGER_HOSTS is empty.
ANSIBLE_MANAGER_1_HOST=
ANSIBLE_MANAGER_1_ADVERTISE_ADDR=

# Target OS validation.
ANSIBLE_TARGET_OS_FAMILY=
ANSIBLE_TARGET_DISTRIBUTION=

# Prerequisite role.
ANSIBLE_PREREQUISITE_DISABLE_SWAP=
ANSIBLE_PREREQUISITE_DISABLE_UFW=
ANSIBLE_PREREQUISITE_TIMEZONE=
ANSIBLE_PREREQUISITE_INSTALL_FROM_LOCAL_REPO=
ANSIBLE_PREREQUISITE_REPO_SOURCE=
ANSIBLE_PREREQUISITE_REPO_DEST=

# Docker role.
ANSIBLE_DOCKER_INSTALL_FROM_LOCAL_REPO=
ANSIBLE_DOCKER_REPO_SOURCE=
ANSIBLE_DOCKER_REPO_DEST=

# Zabbix agent role.
# The control machine is the Zabbix server; set this to the control machine IP
# or DNS name reachable from the target hosts.
ANSIBLE_ZABBIX_AGENT_ENABLED=
ANSIBLE_ZABBIX_AGENT_TARGET_GROUP=
ANSIBLE_ZABBIX_AGENT_HOSTS=
ANSIBLE_ZABBIX_SERVER_HOST=
ANSIBLE_ZABBIX_SERVER_ACTIVE=
ANSIBLE_ZABBIX_AGENT_HOSTNAME=
ANSIBLE_ZABBIX_AGENT_INSTALL_FROM_LOCAL_REPO=
ANSIBLE_ZABBIX_AGENT_REPO_SOURCE=
ANSIBLE_ZABBIX_AGENT_REPO_DEST=
ANSIBLE_ZABBIX_AGENT_MANAGE_APT_REPO=
ANSIBLE_ZABBIX_AGENT_RELEASE_URL=
ANSIBLE_ZABBIX_AGENT_RELEASE_PACKAGE_PATH=
# Must be valid YAML, for example:
# '[zabbix-agent2, zabbix-agent2-plugin-mongodb, zabbix-agent2-plugin-mssql, zabbix-agent2-plugin-postgresql]'
ANSIBLE_ZABBIX_AGENT_PACKAGES=
ANSIBLE_ZABBIX_AGENT_SERVICE_NAME=
ANSIBLE_ZABBIX_AGENT_CONFIG_FILE=
ANSIBLE_ZABBIX_AGENT_REMOVE_LEGACY_AGENT=
ANSIBLE_ZABBIX_AGENT_LEGACY_PACKAGES=
ANSIBLE_ZABBIX_AGENT_LEGACY_SERVICES=

# Used by scripts/build-offline-bundle.sh on the online build machine.
ANSIBLE_ZABBIX_AGENT_DOWNLOAD_PACKAGES=
ANSIBLE_ZABBIX_AGENT_RELEASE_URL=
ANSIBLE_ZABBIX_AGENT_OFFLINE_PACKAGES=
ANSIBLE_ZABBIX_AGENT_UNINSTALL_PACKAGES=
ANSIBLE_ZABBIX_AGENT_UNINSTALL_SERVICES=
ANSIBLE_ZABBIX_AGENT_UNINSTALL_PURGE=
ANSIBLE_ZABBIX_AGENT_UNINSTALL_AUTOREMOVE=
ANSIBLE_ZABBIX_AGENT_UNINSTALL_REMOVE_LOCAL_REPO=

# Dockerized DNS and time server role.
# Images must already exist on the target hosts, or be available as tar files
# on the Ansible control machine for offline docker load.
ANSIBLE_DNS_TIME_SERVICES_ENABLED=
ANSIBLE_DNS_TIME_SERVICES_TARGET_GROUP=
ANSIBLE_DNS_TIME_SERVER_HOSTS=
ANSIBLE_DNS_TIME_SERVICES_LOAD_IMAGES=
ANSIBLE_DNS_TIME_SERVICES_BUILD_IMAGES=
ANSIBLE_DNS_TIME_SERVICES_BASE_DIR=
ANSIBLE_DNS_SERVER_ENABLED=
ANSIBLE_DNS_SERVER_IMAGE=
ANSIBLE_DNS_SERVER_IMAGE_TAR=
# Must be valid YAML, for example: '[172.16.0.0/16]'
ANSIBLE_DNS_SERVER_ALLOW_QUERY=
# Must be valid YAML, for example: '[8.8.8.8, 1.1.1.1]'
ANSIBLE_DNS_SERVER_FORWARDERS=
ANSIBLE_DNS_SERVER_ZONE_SERIAL=
# Must be valid YAML, for example:
# '[{name: bcy.gov.vn, records: [{name: api, type: A, value: 172.16.3.100}]}]'
ANSIBLE_DNS_SERVER_ZONES=
ANSIBLE_TIME_SERVER_ENABLED=
ANSIBLE_TIME_SERVER_IMAGE=
ANSIBLE_TIME_SERVER_IMAGE_TAR=
# Must be valid YAML, for example: '[172.16.0.0/16]'
ANSIBLE_TIME_SERVER_ALLOW=
# Must be valid YAML, for example: '[172.16.5.3]'
ANSIBLE_TIME_SERVER_UPSTREAM_SERVERS=
ANSIBLE_TIME_SERVER_LOCAL_STRATUM=

# NTP client role.
# Default target group excludes the Dockerized NTP servers.
ANSIBLE_NTP_CLIENT_ENABLED=
ANSIBLE_NTP_CLIENT_TARGET_GROUP=
# Must be valid YAML, for example: '[172.16.3.200, 172.16.3.201]'
ANSIBLE_NTP_CLIENT_SERVERS=
# Must be valid YAML, for example: '[]'
ANSIBLE_NTP_CLIENT_FALLBACK_SERVERS=

# External disk role.
ANSIBLE_EXTERNAL_DISK_ENABLED=
ANSIBLE_EXTERNAL_DISK_TARGET_GROUP=
ANSIBLE_EXTERNAL_DISK_HOSTS=
ANSIBLE_EXTERNAL_DISK_DEVICE=
ANSIBLE_EXTERNAL_DISK_PARTITION=
ANSIBLE_EXTERNAL_DISK_MOUNT_PATH=
ANSIBLE_EXTERNAL_DISK_FSTYPE=
ANSIBLE_EXTERNAL_DISK_MOUNT_OPTS=
ANSIBLE_EXTERNAL_DISK_CREATE_PARTITION=
ANSIBLE_EXTERNAL_DISK_FORMAT=

# Hostname role.
ANSIBLE_HOSTNAME_MANAGE=
ANSIBLE_HOSTNAME_VALUE=
ANSIBLE_HOSTNAME_DOMAIN=

# Network role.
# ANSIBLE_NETWORK_DNS_SERVERS must be valid YAML, for example:
# '[192.168.1.1, 8.8.8.8]'
ANSIBLE_NETWORK_MANAGE=
ANSIBLE_NETWORK_INTERFACE=
ANSIBLE_NETWORK_IPV4_ADDRESS=
ANSIBLE_NETWORK_IPV4_PREFIX_LENGTH=
ANSIBLE_NETWORK_IPV4_GATEWAY=
ANSIBLE_NETWORK_DNS_SERVERS=

# Docker Swarm role.
ANSIBLE_DOCKER_SWARM_ENABLED=
ANSIBLE_DOCKER_SWARM_MANAGER_GROUP=
ANSIBLE_DOCKER_SWARM_WORKER_GROUP=
ANSIBLE_DOCKER_SWARM_LISTEN_ADDR=
ANSIBLE_DOCKER_SWARM_PORT=
ANSIBLE_DOCKER_SWARM_FORCE_RESET=
ANSIBLE_DOCKER_SWARM_MANAGER_ADDR=
ANSIBLE_DOCKER_SWARM_MANAGE_IPTABLES=false
ANSIBLE_DOCKER_SWARM_IPTABLES_SOURCE_CIDR=
ANSIBLE_DOCKER_SWARM_MANAGE_ENCRYPTED_OVERLAY_ESP=

# Docker Swarm published service ports.
# Must be valid YAML, for example:
# '[{port: 80, protocol: tcp}, {port: 443, protocol: tcp}]'
ANSIBLE_DOCKER_SWARM_SERVICE_PORTS=

# Docker Swarm node labels.
# Dynamic inventory already creates node_tag labels from ANSIBLE_SWARM_* vars.
# Optional group-level YAML labels can still be merged here when needed.
# Example: '{swarm_backend_workers: {zone: app}}'
ANSIBLE_DOCKER_SWARM_GROUP_LABELS=

# Optional YAML map merged into every Swarm node. Usually keep empty.
# Example: '{rack: rack-a}'
ANSIBLE_DOCKER_SWARM_NODE_LABELS=
